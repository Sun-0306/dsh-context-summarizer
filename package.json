{
  "name": "dsh-context-summarizer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "One-click context summarization from the DSH sidebar: compress a long conversation into a durable summary and free up context. · 在 DSH 左侧栏一键归纳上下文，把过长的对话压成一段摘要并释放上下文占用。",
  "icon": "icon.svg",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sun-0306/dsh-context-summarizer.git"
  },
  "homepage": "https://github.com/Sun-0306/dsh-context-summarizer#readme",
  "bugs": {
    "url": "https://github.com/Sun-0306/dsh-context-summarizer/issues"
  },
  "author": "Sun <Sun-0306@users.noreply.github.com>",
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin"
  ]
}
